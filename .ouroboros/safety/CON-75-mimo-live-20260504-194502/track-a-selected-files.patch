+# pyright: reportUnusedFunction=false, reportAny=false
+from typing import Any
+from unittest.mock import AsyncMock
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from httpx import Response
+
+from exo.api.main import API
+from exo.shared.types.state import State
+
+_MIMO_V25_PRO_MODEL_ID = "XiaomiMiMo/MiMo-V2.5-Pro"
+
+
+def _make_api() -> Any:
+    app = FastAPI()
+    api = object.__new__(API)
+    api.app = app
+    api.state = State()
+    api._text_generation_queues = {}  # pyright: ignore[reportPrivateUsage]
+    api._send = AsyncMock()  # pyright: ignore[reportPrivateUsage]
+    api._trigger_notify_user_to_download_model = AsyncMock()  # pyright: ignore[reportPrivateUsage]
+    api._setup_exception_handlers()  # pyright: ignore[reportPrivateUsage]
+    app.post("/v1/chat/completions", response_model=None)(api.chat_completions)
+    return api
+
+
+def _post_mimo_v25_pro_request_with_content_part(
+    content_part: dict[str, Any],
+) -> tuple[Any, Response]:
+    api = _make_api()
+    client = TestClient(api.app)
+
+    response = client.post(
+        "/v1/chat/completions",
+        json={
+            "model": _MIMO_V25_PRO_MODEL_ID,
+            "messages": [
+                {
+                    "role": "user",
+                    "content": [
+                        {"type": "text", "text": "Summarize this media."},
+                        content_part,
+                    ],
+                }
+            ],
+        },
+    )
+
+    return api, response
+
+
+def _post_non_pro_request_with_content_part(
+    content_part: dict[str, Any],
+) -> tuple[Any, Response]:
+    api = _make_api()
+    client = TestClient(api.app)
+
+    response = client.post(
+        "/v1/chat/completions",
+        json={
+            "model": "some/other-vlm",
+            "messages": [
+                {
+                    "role": "user",
+                    "content": [
+                        {"type": "text", "text": "Describe this media."},
+                        content_part,
+                    ],
+                }
+            ],
+        },
+    )
+
+    return api, response
+
+
+def _post_mimo_v25_pro_text_only_parts_request() -> tuple[Any, Response]:
+    api = _make_api()
+    client = TestClient(api.app)
+
+    response = client.post(
+        "/v1/chat/completions",
+        json={
+            "model": _MIMO_V25_PRO_MODEL_ID,
+            "messages": [
+                {
+                    "role": "user",
+                    "content": [
+                        {"type": "text", "text": "Summarize this text."},
+                        {"type": "text", "text": "Keep the answer concise."},
+                    ],
+                }
+            ],
+        },
+    )
+
+    return api, response
+
+
+def _assert_mimo_v25_pro_media_request_rejected(
+    *,
+    content_part: dict[str, Any],
+    media_kind: str,
+) -> None:
+    api, response = _post_mimo_v25_pro_request_with_content_part(content_part)
+
+    assert response.status_code == 400
+    data: dict[str, Any] = response.json()
+    message = data["error"]["message"]
+    assert "XiaomiMiMo/MiMo-V2.5-Pro" in message
+    assert "text-only" in message
+    assert "supports text-only requests in this slice" in message
+    assert media_kind in message
+    api._send.assert_not_called()
+    api._trigger_notify_user_to_download_model.assert_not_called()
+
+
+def test_mimo_v25_pro_chat_rejects_image_content_part_without_sending_inference() -> None:
+    _assert_mimo_v25_pro_media_request_rejected(
+        content_part={
+            "type": "image_url",
+            "image_url": {"url": "data:image/png;base64,aW1hZ2U="},
+        },
+        media_kind="image",
+    )
+
+
+def test_mimo_v25_pro_chat_rejects_video_content_part_without_sending_inference() -> None:
+    _assert_mimo_v25_pro_media_request_rejected(
+        content_part={
+            "type": "video_url",
+            "video_url": {"url": "data:video/mp4;base64,dmlkZW8="},
+        },
+        media_kind="video",
+    )
+
+
+def test_mimo_v25_pro_chat_rejects_audio_content_part_without_sending_inference() -> None:
+    _assert_mimo_v25_pro_media_request_rejected(
+        content_part={
+            "type": "input_audio",
+            "input_audio": {"data": "YXVkaW8=", "format": "wav"},
+        },
+        media_kind="audio",
+    )
+
+
+def test_mimo_v25_pro_chat_rejects_multimodal_content_part_without_sending_inference() -> None:
+    _assert_mimo_v25_pro_media_request_rejected(
+        content_part={
+            "type": "multimodal",
+            "multimodal": {"media": [{"kind": "image", "url": "data:image/png;base64,aW1hZ2U="}]},
+        },
+        media_kind="multimodal",
+    )
+
+
+def test_mimo_v25_pro_chat_rejects_omnimodal_content_part_without_sending_inference() -> None:
+    _assert_mimo_v25_pro_media_request_rejected(
+        content_part={
+            "type": "omnimodal",
+            "omnimodal": {
+                "inputs": [
+                    {"kind": "image", "url": "data:image/png;base64,aW1hZ2U="},
+                    {"kind": "audio", "data": "YXVkaW8="},
+                ]
+            },
+        },
+        media_kind="omnimodal",
+    )
+
+
+def test_mimo_v25_pro_chat_text_only_parts_keep_model_resolution_behavior() -> None:
+    api, response = _post_mimo_v25_pro_text_only_parts_request()
+
+    assert response.status_code == 404
+    data: dict[str, Any] = response.json()
+    assert (
+        data["error"]["message"]
+        == "No instance found for model XiaomiMiMo/MiMo-V2.5-Pro"
+    )
+    api._send.assert_not_called()
+    api._trigger_notify_user_to_download_model.assert_called_once()
+
+
+def test_non_pro_chat_image_content_part_keeps_existing_model_resolution_behavior() -> None:
+    api, response = _post_non_pro_request_with_content_part(
+        {
+            "type": "image_url",
+            "image_url": {"url": "data:image/png;base64,aW1hZ2U="},
+        }
+    )
+
+    assert response.status_code == 404
+    data: dict[str, Any] = response.json()
+    assert data["error"]["message"] == "No instance found for model some/other-vlm"
+    api._send.assert_not_called()
+    api._trigger_notify_user_to_download_model.assert_called_once()
+
+
+@pytest.mark.parametrize(
+    ("content_part", "expected_message"),
+    [
+        (
+            {
+                "type": "multimodal",
+                "multimodal": {
+                    "media": [
+                        {"kind": "image", "url": "data:image/png;base64,aW1hZ2U="}
+                    ]
+                },
+            },
+            "multimodal chat content parts are not supported.",
+        ),
+        (
+            {
+                "type": "omnimodal",
+                "omnimodal": {
+                    "inputs": [
+                        {"kind": "image", "url": "data:image/png;base64,aW1hZ2U="},
+                        {"kind": "audio", "data": "YXVkaW8="},
+                    ]
+                },
+            },
+            "omnimodal chat content parts are not supported.",
+        ),
+    ],
+)
+def test_non_pro_chat_multimodal_and_omnimodal_parts_keep_existing_422_behavior(
+    content_part: dict[str, Any],
+    expected_message: str,
+) -> None:
+    api, response = _post_non_pro_request_with_content_part(content_part)
+
+    assert response.status_code == 422
+    data: dict[str, Any] = response.json()
+    assert data["error"]["message"] == expected_message
+    api._send.assert_not_called()
+    api._trigger_notify_user_to_download_model.assert_not_called()
+
+
+@pytest.mark.parametrize(
+    "content_part",
+    [
+        {"type": "video_url", "video_url": {"url": "data:video/mp4;base64,dmlkZW8="}},
+        {"type": "input_audio", "input_audio": {"data": "YXVkaW8=", "format": "wav"}},
+    ],
+)
+def test_non_pro_chat_unsupported_video_and_audio_content_parts_keep_existing_422_behavior(
+    content_part: dict[str, Any],
+) -> None:
+    api, response = _post_non_pro_request_with_content_part(content_part)
+
+    assert response.status_code == 422
+    data: dict[str, Any] = response.json()
+    assert data["error"]["message"] == "video and audio chat content parts are not supported."
+    api._send.assert_not_called()
+    api._trigger_notify_user_to_download_model.assert_not_called()
