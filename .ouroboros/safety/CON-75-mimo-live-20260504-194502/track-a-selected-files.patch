+import pytest
+from anyio import Path
+from pydantic import ValidationError
+
+from exo.shared.models.model_cards import ConfigData, ModelCard, ModelTask
+
+
+async def test_mimo_v25_pro_builtin_model_card_is_text_only_agentic_long_context() -> (
+    None
+):
+    card = await ModelCard.load_from_path(
+        Path("resources/inference_model_cards/XiaomiMiMo--MiMo-V2.5-Pro.toml")
+    )
+
+    assert card.model_id == "XiaomiMiMo/MiMo-V2.5-Pro"
+    assert card.tasks == [ModelTask.TextGeneration]
+    assert card.capabilities == ["text", "agentic", "long-context"]
+    assert card.context_length == 1_048_576
+    assert card.hidden_size == 6_144
+    assert card.n_layers == 70
+    assert card.num_key_value_heads == 8
+    assert card.architecture == "MiMoV2ForCausalLM"
+    assert card.vision is None
+
+    media_markers = {
+        "image",
+        "images",
+        "speech",
+        "vision",
+        "video",
+        "audio",
+        "omni",
+        "omnimodal",
+        "multimodal",
+    }
+    assert media_markers.isdisjoint(
+        {capability.lower() for capability in card.capabilities}
+    )
+
+
+@pytest.mark.parametrize(
+    "media_capability",
+    [
+        "vision",
+        "image",
+        "video",
+        "audio",
+        "speech",
+        "multimodal",
+        "omnimodal",
+    ],
+)
+def test_mimo_v25_pro_model_card_rejects_media_capability_metadata(
+    media_capability: str,
+) -> None:
+    with pytest.raises(ValidationError, match="must not declare media capabilities"):
+        ModelCard.model_validate(
+            {
+                "model_id": "XiaomiMiMo/MiMo-V2.5-Pro",
+                "storage_size": {"in_bytes": 1},
+                "n_layers": 70,
+                "hidden_size": 6144,
+                "num_key_value_heads": 8,
+                "supports_tensor": True,
+                "tasks": ["TextGeneration"],
+                "architecture": "MiMoV2ForCausalLM",
+                "capabilities": ["text", media_capability],
+                "context_length": 1_048_576,
+            }
+        )
+
+
+@pytest.mark.parametrize(
+    "media_task",
+    [
+        "TextToImage",
+        "ImageToImage",
+    ],
+)
+def test_mimo_v25_pro_model_card_rejects_non_text_generation_tasks(
+    media_task: str,
+) -> None:
+    with pytest.raises(ValidationError, match="supports text generation only"):
+        ModelCard.model_validate(
+            {
+                "model_id": "XiaomiMiMo/MiMo-V2.5-Pro",
+                "storage_size": {"in_bytes": 1},
+                "n_layers": 70,
+                "hidden_size": 6144,
+                "num_key_value_heads": 8,
+                "supports_tensor": True,
+                "tasks": ["TextGeneration", media_task],
+                "architecture": "MiMoV2ForCausalLM",
+                "capabilities": ["text", "agentic", "long-context"],
+                "context_length": 1_048_576,
+            }
+        )
+
+
+def test_mimo_v25_pro_config_data_allows_text_causal_lm_when_mtp_absent() -> None:
+    config_data = ConfigData.model_validate(
+        {
+            "architectures": ["MiMoV2ForCausalLM"],
+            "num_hidden_layers": 70,
+            "hidden_size": 6144,
+            "num_key_value_heads": 8,
+            "max_position_embeddings": 1_048_576,
+        }
+    )
+
+    assert config_data.supports_tensor is True
+
+
+def test_mimo_v25_pro_config_data_allows_text_causal_lm_when_mtp_disabled() -> None:
+    config_data = ConfigData.model_validate(
+        {
+            "architectures": ["MiMoV2ForCausalLM"],
+            "num_hidden_layers": 70,
+            "hidden_size": 6144,
+            "num_key_value_heads": 8,
+            "max_position_embeddings": 1_048_576,
+            "num_nextn_predict_layers": 0,
+            "mtp_enabled": False,
+            "use_mtp": False,
+            "mtp_config": {"enabled": False, "num_layers": 0},
+        }
+    )
+
+    assert config_data.supports_tensor is True
+    assert config_data.vision is None
+
+
+@pytest.mark.parametrize(
+    "enabled_mtp_metadata",
+    [
+        {"num_nextn_predict_layers": 1},
+        {"mtp_enabled": True},
+        {"use_mtp": True},
+        {"mtp_config": {"enabled": True}},
+        {"mtp_config": {"num_layers": 1}},
+    ],
+)
+def test_mimo_v25_pro_config_data_flags_enabled_mtp_as_not_tensor_supported(
+    enabled_mtp_metadata: dict[str, object],
+) -> None:
+    config_data = ConfigData.model_validate(
+        {
+            "architectures": ["MiMoV2ForCausalLM"],
+            "num_hidden_layers": 70,
+            "hidden_size": 6144,
+            "num_key_value_heads": 8,
+            "max_position_embeddings": 1_048_576,
+            **enabled_mtp_metadata,
+        }
+    )
+
+    assert config_data.supports_tensor is False
+    assert config_data.vision is None
diff --git a/src/exo/worker/engines/mlx/mimo_v25_pro_config.py b/src/exo/worker/engines/mlx/mimo_v25_pro_config.py
new file mode 100644
index 00000000..17fc55ca
--- /dev/null
+++ b/src/exo/worker/engines/mlx/mimo_v25_pro_config.py
@@ -0,0 +1,507 @@
+from pathlib import Path
+from typing import Final, Literal, cast
+
+from pydantic import TypeAdapter, ValidationError
+
+from exo.shared.types.common import ModelId
+
+MIMO_V25_PRO_MODEL_ID: Final[ModelId] = ModelId("XiaomiMiMo/MiMo-V2.5-Pro")
+MIMO_V25_PRO_MODEL_TYPE: Final[Literal["mimo_v2"]] = "mimo_v2"
+MIMO_V25_PRO_ARCHITECTURE: Final[Literal["MiMoV2ForCausalLM"]] = (
+    "MiMoV2ForCausalLM"
+)
+MIMO_V25_PRO_QUANT_METHOD: Final[Literal["fp8"]] = "fp8"
+MIMO_V25_PRO_FP8_FORMAT: Final[Literal["e4m3"]] = "e4m3"
+MIMO_V25_PRO_ACTIVATION_SCHEME: Final[Literal["dynamic"]] = "dynamic"
+MIMO_V25_PRO_WEIGHT_BLOCK_SIZE: Final[tuple[Literal[128], Literal[128]]] = (
+    128,
+    128,
+)
+MIMO_V25_PRO_NUM_HIDDEN_LAYERS: Final[Literal[70]] = 70
+MIMO_V25_PRO_INTERMEDIATE_SIZE: Final[Literal[16384]] = 16384
+MIMO_V25_PRO_MOE_INTERMEDIATE_SIZE: Final[Literal[2048]] = 2048
+MIMO_V25_PRO_ROUTED_EXPERTS: Final[Literal[384]] = 384
+MIMO_V25_PRO_EXPERTS_PER_TOKEN: Final[Literal[8]] = 8
+MIMO_V25_PRO_MOE_LAYER_FREQ: Final[tuple[int, ...]] = (0, *([1] * 69))
+MIMO_V25_PRO_EXPERT_GROUPS: Final[Literal[1]] = 1
+MIMO_V25_PRO_TOPK_GROUPS: Final[Literal[1]] = 1
+MIMO_V25_PRO_TOPK_METHOD: Final[Literal["noaux_tc"]] = "noaux_tc"
+MIMO_V25_PRO_SCORING_FUNC: Final[Literal["sigmoid"]] = "sigmoid"
+MIMO_V25_PRO_NORM_TOPK_PROB: Final[Literal[True]] = True
+MIMO_V25_PRO_HYBRID_LAYER_PATTERN: Final[tuple[int, ...]] = (
+    0,
+    *([1] * 6),
+    0,
+    *([1] * 7),
+    0,
+    *([1] * 7),
+    0,
+    *([1] * 7),
+    0,
+    *([1] * 7),
+    0,
+    *([1] * 7),
+    0,
+    *([1] * 7),
+    0,
+    *([1] * 6),
+    0,
+    *([1] * 6),
+    0,
+)
+MIMO_V25_PRO_FULL_ATTENTION_SINK_BIAS: Final[Literal[False]] = False
+MIMO_V25_PRO_SWA_ATTENTION_SINK_BIAS: Final[Literal[True]] = True
+MIMO_V25_PRO_ATTENTION_CHUNK_SIZE: Final[Literal[128]] = 128
+MIMO_V25_PRO_SLIDING_WINDOW: Final[Literal[128]] = 128
+MIMO_V25_PRO_SLIDING_WINDOW_SIZE: Final[Literal[128]] = 128
+MIMO_V25_PRO_MAX_POSITION_EMBEDDINGS: Final[Literal[1048576]] = 1048576
+MIMO_V25_PRO_ROPE_THETA: Final[Literal[10000000]] = 10000000
+MIMO_V25_PRO_SWA_ROPE_THETA: Final[Literal[10000]] = 10000
+MIMO_V25_PRO_ATTENTION_VALUE_SCALE: Final[float] = 0.612
+MIMO_V25_PRO_DISABLED_MTP_FIELDS: Final[tuple[str, ...]] = (
+    "num_nextn_predict_layers",
+    "mtp_enabled",
+    "use_mtp",
+)
+MIMO_V25_PRO_MTP_CONFIG_FIELD: Final[Literal["mtp_config"]] = "mtp_config"
+_CONFIG_JSON_ADAPTER: Final[TypeAdapter[dict[str, object]]] = TypeAdapter(
+    dict[str, object]
+)
+_QUANTIZATION_CONFIG_ADAPTER: Final[TypeAdapter[dict[str, object]]] = TypeAdapter(
+    dict[str, object]
+)
+
+
+def validate_mimo_v25_pro_config_if_applicable(
+    model_id: ModelId,
+    model_path: Path,
+) -> None:
+    """Validate the local MiMo-V2.5-Pro MLX config before model loading.
+
+    This is intentionally a narrow Track A guard: only XiaomiMiMo/MiMo-V2.5-Pro
+    is checked, and the accepted architecture marker is the text-only MiMo V2
+    causal-LM config value. Other models keep their existing MLX load behavior.
+    """
+    if model_id != MIMO_V25_PRO_MODEL_ID:
+        return
+
+    config_path = model_path / "config.json"
+    try:
+        raw_config = _CONFIG_JSON_ADAPTER.validate_json(
+            config_path.read_text(encoding="utf-8")
+        )
+    except FileNotFoundError as exc:
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} requires local config.json with "
+            f"model_type={MIMO_V25_PRO_MODEL_TYPE}"
+        ) from exc
+    except ValidationError as exc:
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json must be a JSON object"
+        ) from exc
+
+    _validate_mimo_v25_pro_model_type(raw_config)
+    _validate_mimo_v25_pro_architecture(raw_config)
+    _validate_mimo_v25_pro_quantization_metadata(raw_config)
+    _validate_mimo_v25_pro_moe_expert_metadata(raw_config)
+    _validate_mimo_v25_pro_mtp_metadata_disabled(raw_config)
+    _validate_mimo_v25_pro_hybrid_attention_metadata(raw_config)
+
+
+def _validate_mimo_v25_pro_model_type(raw_config: dict[str, object]) -> None:
+    model_type = raw_config.get("model_type")
+    if model_type == MIMO_V25_PRO_MODEL_TYPE:
+        return
+
+    if model_type is None:
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json is missing model_type; "
+            f"expected {MIMO_V25_PRO_MODEL_TYPE}"
+        )
+
+    raise ValueError(
+        f"{MIMO_V25_PRO_MODEL_ID} config.json has incompatible model_type "
+        f"{model_type!r}; expected {MIMO_V25_PRO_MODEL_TYPE}"
+    )
+
+
+def _validate_mimo_v25_pro_architecture(raw_config: dict[str, object]) -> None:
+    architectures = raw_config.get("architectures")
+    if isinstance(architectures, list) and MIMO_V25_PRO_ARCHITECTURE in architectures:
+        return
+
+    if architectures is None:
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json is missing architectures; "
+            f"expected {MIMO_V25_PRO_ARCHITECTURE}"
+        )
+
+    raise ValueError(
+        f"{MIMO_V25_PRO_MODEL_ID} config.json has incompatible architectures "
+        f"{architectures!r}; expected {MIMO_V25_PRO_ARCHITECTURE}"
+    )
+
+
+def _validate_mimo_v25_pro_quantization_metadata(
+    raw_config: dict[str, object]
+) -> None:
+    quantization_config = raw_config.get("quantization_config")
+    if not isinstance(quantization_config, dict):
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json is missing "
+            "quantization_config; expected fp8 e4m3 metadata"
+        )
+
+    try:
+        quantization_fields = _QUANTIZATION_CONFIG_ADAPTER.validate_python(
+            quantization_config
+        )
+    except ValidationError as exc:
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} quantization_config must be a JSON object"
+        ) from exc
+
+    _validate_quantization_field(
+        quantization_fields,
+        "quant_method",
+        MIMO_V25_PRO_QUANT_METHOD,
+    )
+    _validate_quantization_field(
+        quantization_fields,
+        "fmt",
+        MIMO_V25_PRO_FP8_FORMAT,
+    )
+    _validate_quantization_field(
+        quantization_fields,
+        "activation_scheme",
+        MIMO_V25_PRO_ACTIVATION_SCHEME,
+    )
+    _validate_quantization_field(
+        quantization_fields,
+        "weight_block_size",
+        list(MIMO_V25_PRO_WEIGHT_BLOCK_SIZE),
+    )
+
+
+
+def _validate_mimo_v25_pro_moe_expert_metadata(
+    raw_config: dict[str, object]
+) -> None:
+    _validate_mimo_v25_pro_moe_routing_consistency(raw_config)
+    _validate_config_field(
+        raw_config,
+        "n_routed_experts",
+        MIMO_V25_PRO_ROUTED_EXPERTS,
+    )
+    _validate_config_field(
+        raw_config,
+        "num_experts_per_tok",
+        MIMO_V25_PRO_EXPERTS_PER_TOKEN,
+    )
+    _validate_config_field(
+        raw_config,
+        "intermediate_size",
+        MIMO_V25_PRO_INTERMEDIATE_SIZE,
+    )
+    _validate_config_field(
+        raw_config,
+        "moe_intermediate_size",
+        MIMO_V25_PRO_MOE_INTERMEDIATE_SIZE,
+    )
+    _validate_config_field(
+        raw_config,
+        "n_group",
+        MIMO_V25_PRO_EXPERT_GROUPS,
+    )
+    _validate_config_field(
+        raw_config,
+        "topk_group",
+        MIMO_V25_PRO_TOPK_GROUPS,
+    )
+    _validate_config_field(
+        raw_config,
+        "topk_method",
+        MIMO_V25_PRO_TOPK_METHOD,
+    )
+    _validate_config_field(
+        raw_config,
+        "scoring_func",
+        MIMO_V25_PRO_SCORING_FUNC,
+    )
+    _validate_config_field(
+        raw_config,
+        "norm_topk_prob",
+        MIMO_V25_PRO_NORM_TOPK_PROB,
+    )
+    _validate_mimo_v25_pro_moe_layer_freq(raw_config)
+
+def _validate_mimo_v25_pro_moe_layer_freq(
+    raw_config: dict[str, object]
+) -> None:
+    moe_layer_freq = raw_config.get("moe_layer_freq")
+    if moe_layer_freq is None:
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json is missing moe_layer_freq; "
+            f"expected {MIMO_V25_PRO_NUM_HIDDEN_LAYERS} entries"
+        )
+
+    if not isinstance(moe_layer_freq, list):
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json has incompatible "
+            "moe_layer_freq; expected a JSON array with "
+            f"{MIMO_V25_PRO_NUM_HIDDEN_LAYERS} entries"
+        )
+
+    moe_layer_freq_values = cast(list[object], moe_layer_freq)
+    num_hidden_layers = raw_config.get("num_hidden_layers")
+    if not isinstance(num_hidden_layers, int):
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json is missing "
+            "num_hidden_layers required to validate moe_layer_freq"
+        )
+
+    if len(moe_layer_freq_values) != num_hidden_layers:
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json moe_layer_freq has "
+            f"{len(moe_layer_freq_values)} entries; expected num_hidden_layers "
+            f"{num_hidden_layers}"
+        )
+
+    expected_moe_layer_freq = list(MIMO_V25_PRO_MOE_LAYER_FREQ)
+    if moe_layer_freq_values != expected_moe_layer_freq:
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json has incompatible "
+            f"moe_layer_freq {moe_layer_freq_values!r}; expected "
+            f"{MIMO_V25_PRO_NUM_HIDDEN_LAYERS} entries matching "
+            "the Pro text MoE layer pattern"
+        )
+
+def _validate_mimo_v25_pro_moe_routing_consistency(
+    raw_config: dict[str, object]
+) -> None:
+    n_routed_experts = raw_config.get("n_routed_experts")
+    num_experts_per_tok = raw_config.get("num_experts_per_tok")
+    if (
+        isinstance(n_routed_experts, int)
+        and isinstance(num_experts_per_tok, int)
+        and num_experts_per_tok > n_routed_experts
+    ):
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json has num_experts_per_tok "
+            f"{num_experts_per_tok} greater than n_routed_experts "
+            f"{n_routed_experts}"
+        )
+
+    n_group = raw_config.get("n_group")
+    topk_group = raw_config.get("topk_group")
+    if (
+        isinstance(n_group, int)
+        and isinstance(topk_group, int)
+        and topk_group > n_group
+    ):
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json has topk_group "
+            f"{topk_group} greater than n_group {n_group}"
+        )
+
+
+def _validate_mimo_v25_pro_mtp_metadata_disabled(
+    raw_config: dict[str, object]
+) -> None:
+    """Fail closed if Pro config advertises enabled MTP/next-token heads."""
+    for field_name in MIMO_V25_PRO_DISABLED_MTP_FIELDS:
+        if field_name in raw_config:
+            _validate_mimo_v25_pro_mtp_field_disabled(
+                field_name,
+                raw_config[field_name],
+            )
+
+    if MIMO_V25_PRO_MTP_CONFIG_FIELD in raw_config:
+        _validate_mimo_v25_pro_mtp_config_disabled(
+            raw_config[MIMO_V25_PRO_MTP_CONFIG_FIELD]
+        )
+
+
+def _validate_mimo_v25_pro_mtp_config_disabled(mtp_config: object) -> None:
+    if mtp_config is None:
+        return
+
+    if not isinstance(mtp_config, dict):
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json has incompatible "
+            f"{MIMO_V25_PRO_MTP_CONFIG_FIELD} {mtp_config!r}; MTP must be "
+            "disabled for Track A text-only Pro support"
+        )
+
+    mtp_config_fields = cast(dict[str, object], mtp_config)
+    for config_field_name, config_field_value in mtp_config_fields.items():
+        if _is_mimo_v25_pro_disabled_mtp_value(config_field_value):
+            continue
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json has incompatible "
+            f"{MIMO_V25_PRO_MTP_CONFIG_FIELD}.{config_field_name} "
+            f"{config_field_value!r}; MTP must be disabled for Track A "
+            "text-only Pro support"
+        )
+
+
+def _validate_mimo_v25_pro_mtp_field_disabled(
+    field_name: str,
+    field_value: object,
+) -> None:
+    if _is_mimo_v25_pro_disabled_mtp_value(field_value):
+        return
+
+    raise ValueError(
+        f"{MIMO_V25_PRO_MODEL_ID} config.json has incompatible "
+        f"{field_name} {field_value!r}; MTP must be disabled for Track A "
+        "text-only Pro support"
+    )
+
+
+def _is_mimo_v25_pro_disabled_mtp_value(field_value: object) -> bool:
+    return (
+        field_value is None
+        or field_value is False
+        or (
+            isinstance(field_value, int)
+            and not isinstance(field_value, bool)
+            and field_value == 0
+        )
+    )
+
+
+def _validate_mimo_v25_pro_hybrid_attention_metadata(
+    raw_config: dict[str, object]
+) -> None:
+    _validate_mimo_v25_pro_hybrid_layer_pattern(raw_config)
+    _validate_config_field(
+        raw_config,
+        "add_full_attention_sink_bias",
+        MIMO_V25_PRO_FULL_ATTENTION_SINK_BIAS,
+    )
+    _validate_config_field(
+        raw_config,
+        "add_swa_attention_sink_bias",
+        MIMO_V25_PRO_SWA_ATTENTION_SINK_BIAS,
+    )
+    _validate_config_field(
+        raw_config,
+        "attention_chunk_size",
+        MIMO_V25_PRO_ATTENTION_CHUNK_SIZE,
+    )
+    _validate_config_field(
+        raw_config,
+        "sliding_window",
+        MIMO_V25_PRO_SLIDING_WINDOW,
+    )
+    _validate_config_field(
+        raw_config,
+        "sliding_window_size",
+        MIMO_V25_PRO_SLIDING_WINDOW_SIZE,
+    )
+    _validate_config_field(
+        raw_config,
+        "max_position_embeddings",
+        MIMO_V25_PRO_MAX_POSITION_EMBEDDINGS,
+    )
+    _validate_config_field(
+        raw_config,
+        "rope_theta",
+        MIMO_V25_PRO_ROPE_THETA,
+    )
+    _validate_config_field(
+        raw_config,
+        "swa_rope_theta",
+        MIMO_V25_PRO_SWA_ROPE_THETA,
+    )
+    _validate_config_field(
+        raw_config,
+        "attention_value_scale",
+        MIMO_V25_PRO_ATTENTION_VALUE_SCALE,
+    )
+
+
+def _validate_mimo_v25_pro_hybrid_layer_pattern(
+    raw_config: dict[str, object]
+) -> None:
+    hybrid_layer_pattern = raw_config.get("hybrid_layer_pattern")
+    if hybrid_layer_pattern is None:
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json is missing "
+            "hybrid_layer_pattern; expected 70 entries for hybrid full/SWA "
+            "attention"
+        )
+
+    if not isinstance(hybrid_layer_pattern, list):
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json has incompatible "
+            "hybrid_layer_pattern; expected a JSON array with "
+            f"{MIMO_V25_PRO_NUM_HIDDEN_LAYERS} entries for hybrid full/SWA "
+            "attention"
+        )
+
+    hybrid_layer_pattern_values = cast(list[object], hybrid_layer_pattern)
+    num_hidden_layers = raw_config.get("num_hidden_layers")
+    if not isinstance(num_hidden_layers, int):
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json is missing "
+            "num_hidden_layers required to validate hybrid_layer_pattern"
+        )
+
+    if len(hybrid_layer_pattern_values) != num_hidden_layers:
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json hybrid_layer_pattern has "
+            f"{len(hybrid_layer_pattern_values)} entries; expected "
+            f"num_hidden_layers {num_hidden_layers}"
+        )
+
+    expected_hybrid_layer_pattern = list(MIMO_V25_PRO_HYBRID_LAYER_PATTERN)
+    if hybrid_layer_pattern_values != expected_hybrid_layer_pattern:
+        raise ValueError(
+            f"{MIMO_V25_PRO_MODEL_ID} config.json has incompatible "
+            f"hybrid_layer_pattern {hybrid_layer_pattern_values!r}; expected "
+            "the Pro text hybrid full/SWA attention pattern"
+        )
