+_MIMO_V25_PRO_MODEL_ID = ModelId("XiaomiMiMo/MiMo-V2.5-Pro")
+_ChatCompletionMediaKind: TypeAlias = Literal[
+    "image", "video", "audio", "multimodal", "omnimodal"
+]
+_NON_IMAGE_CHAT_COMPLETION_MEDIA_KINDS: Final[set[_ChatCompletionMediaKind]] = {
+    "video",
+    "audio",
+    "multimodal",
+    "omnimodal",
